# 服务监听端口（宿主机映射端口；在 Render 等云平台运行时会自动读取平台注入的 PORT）
PORT=8787

# 是否启用访问令牌认证（默认开启，建议保持 true）
ACCESS_TOKEN_ENABLED=true

# 生产环境访问令牌（请务必修改为强随机密码）
ACCESS_TOKEN=change-me-to-a-strong-token

# 可选：PostgreSQL 连接串（配置后自动启用 PostgreSQL 持久化，适合 Aiven / Neon / Supabase / 自建 PG 等平台）
# 留空则自动使用本地 SQLite（${DATA_DIR}/clash-sub.sqlite）
# Aiven 示例：postgres://avnadmin:password@pg-xxx.aivencloud.com:12345/defaultdb?sslmode=require
# DATABASE_URL=postgres://avnadmin:password@pg-xxx.aivencloud.com:12345/defaultdb?sslmode=require

# 可选：手动控制 PostgreSQL SSL（默认远程域名/带 sslmode=require 自动启用 TLS，兼容 Aiven 自签名 CA）
# 可选值：true / false / verify-full / no-verify
# DATABASE_SSL=true

# 可选：Aiven 等平台提供的自定义 CA 证书（支持直接粘贴 PEM、单行 \n 转义或 Base64 编码的 PEM）
# 配置后将自动开启严格证书校验 (rejectUnauthorized: true)
# DATABASE_CA_CERT=

# 可选：PostgreSQL 连接池最大连接数（默认 5，适合 Aiven 免费版 20 连接上限）
# PG_POOL_MAX=5

# 可选：开发环境令牌（仅在未设置 ACCESS_TOKEN 或 ENVIRONMENT=development 时生效）
# ACCESS_TOKEN_DEV=dev-token-123

# 可选：运行环境标识（production / development）
ENVIRONMENT=production

# 反向代理（Render / Nginx / Caddy / Cloudflare Tunnel 等）场景下识别 X-Forwarded-Proto/Host
TRUST_PROXY=true
